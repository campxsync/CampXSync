# =============================================================================
# CampXSync Docker Environment — SECRET TEMPLATE
# =============================================================================
# 1. Copy this file: cp .env.docker.example infrastructure/docker/.env.docker
# 2. Fill in strong passwords before running docker-compose
# 3. NEVER commit .env.docker to source control (.gitignore excludes it)
# =============================================================================

# MongoDB credentials (must match MONGO_INITDB_ROOT_USERNAME/PASSWORD in docker-compose)
MONGO_INITDB_ROOT_USERNAME=campxsync_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_password_here

# Full MongoDB connection URI used by microservices
MONGO_URI=mongodb://campxsync_admin:CHANGE_ME_strong_password_here@mongodb:27017/campxsync?authSource=admin

# Redis password (must match --requirepass in docker-compose redis command)
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# Service discovery (internal Docker network hostnames — do not change)
REDIS_HOST=redis
MONGO_HOST=mongodb

# Image tag for pre-built images (used when pulling from registry instead of building)
IMAGE_TAG=1.0.0
